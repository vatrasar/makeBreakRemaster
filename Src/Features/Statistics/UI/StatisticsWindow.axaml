<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:makeBreak.Src.Features.Statistics.Resources"
        xmlns:models="using:makeBreak.Src.Features.Statistics.Domain.Models"
        x:Class="makeBreak.Src.Features.Statistics.UI.StatisticsWindow"
        Title="{x:Static res:StatisticsStrings.WindowTitle}"
        Icon="/Assets/ikona.png"
        Width="520"
        Height="415"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Styles>
        <StyleInclude Source="avares://makeBreak/Src/Features/Statistics/UI/ScreenStyles/ButtonsStyles.axaml" />
        <StyleInclude Source="avares://makeBreak/Src/Features/Statistics/UI/ScreenStyles/TextBlocksStyles.axaml" />
        <StyleInclude Source="avares://makeBreak/Src/Features/Statistics/UI/ScreenStyles/BarsStyles.axaml" />
    </Window.Styles>

    <Border Margin="14"
            CornerRadius="14"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                <RadioButton x:Name="WorkModeButton"
                             Grid.Column="0"
                             Classes="nav-tab"
                             GroupName="StatisticsMode"
                             Content="{x:Static res:StatisticsStrings.WorkModeLabel}" />
                <RadioButton x:Name="WastedModeButton"
                             Grid.Column="1"
                             Classes="nav-tab wasted"
                             GroupName="StatisticsMode"
                             Content="{x:Static res:StatisticsStrings.WastedModeLabel}" />
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource CardStrokeColorDefaultBrush}" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,Auto"
                  Margin="20,14,20,10"
                  VerticalAlignment="Center">
                <TextBlock x:Name="SectionTitleTextBlock"
                           Grid.Column="0"
                           Classes="section-title"
                           VerticalAlignment="Center" />

                <Border Grid.Column="1"
                        Classes="period-container"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="2">
                        <RadioButton x:Name="WeekPeriodButton"
                                     Grid.Column="0"
                                     Classes="period-button"
                                     GroupName="StatisticsPeriod"
                                     Content="{x:Static res:StatisticsStrings.WeekPeriodLabel}" />
                        <RadioButton x:Name="MonthPeriodButton"
                                     Grid.Column="1"
                                     Classes="period-button"
                                     GroupName="StatisticsPeriod"
                                     Content="{x:Static res:StatisticsStrings.MonthPeriodLabel}" />
                        <RadioButton x:Name="YearPeriodButton"
                                     Grid.Column="2"
                                     Classes="period-button"
                                     GroupName="StatisticsPeriod"
                                     Content="{x:Static res:StatisticsStrings.YearPeriodLabel}" />
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="3"
                          Margin="20,4,20,10"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="BarsList" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:WorkBarEntry">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="DayLabelColumn" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="TimeColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           Classes="day-label"
                                           VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="1"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BarPercent}"
                                             Classes.work-bar="True"
                                             Classes.best="{Binding IsBest}"
                                             Classes.worst="{Binding IsWorst}"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding WorkTimeLabel}"
                                           Classes="day-time"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="4"
                    Classes="summary-badge"
                    HorizontalAlignment="Center"
                    Margin="20,6,20,14">
                <TextBlock x:Name="TotalTimeTextBlock"
                           Classes="total-label"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
