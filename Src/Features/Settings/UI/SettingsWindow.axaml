<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:makeBreak.Src.Features.Settings.Resources"
        xmlns:gres="using:makeBreak.Src.Shared.Resources"
        xmlns:models="using:makeBreak.Src.Core.Domain.Models"
        x:Class="makeBreak.Src.Features.Settings.UI.SettingsWindow"
        Title="{x:Static res:SettingsStrings.WindowTitle}"
        Icon="/Assets/ikona.png"
        Width="470"
        Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Window.Styles>
        <StyleInclude Source="avares://makeBreak/Src/Features/Settings/UI/ScreenStyles/ButtonsStyles.axaml" />
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto"
          Margin="24"
          RowSpacing="12">

        <TextBlock Grid.Row="0" Text="{x:Static res:SettingsStrings.WindowTitle}"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,18,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static res:SettingsStrings.TimeToStartLongBreakLabel}" />
                    <NumericUpDown x:Name="TimeToStartLongBreakInput" Minimum="1" Increment="1" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static res:SettingsStrings.TimeForLongBreakLabel}" />
                    <NumericUpDown x:Name="TimeForLongBreakInput" Minimum="1" Increment="1" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static res:SettingsStrings.TimeToStartShortBreakLabel}" />
                    <NumericUpDown x:Name="TimeToStartShortBreakInput" Minimum="1" Increment="1" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Static res:SettingsStrings.TimeForShortBreakLabel}" />
                    <NumericUpDown x:Name="TimeForShortBreakInput" Minimum="1" Increment="1" />
                </StackPanel>

                <CheckBox x:Name="VoiceNotificationsCheckBox"
                          Content="{x:Static res:SettingsStrings.VoiceNotificationsLabel}"
                          Margin="0,4,0,0" />

                <StackPanel Spacing="6" Margin="0,4,0,0">
                    <TextBlock Text="{x:Static res:SettingsStrings.AudioOutputDeviceLabel}" />
                    <ComboBox x:Name="AudioOutputDeviceComboBox"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioDevice">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{x:Static res:SettingsStrings.VoiceVolumeLabel}" VerticalAlignment="Center" />
                        <TextBlock x:Name="VoiceVolumePercentTextBlock" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="VoiceVolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            HorizontalAlignment="Stretch" />
                </StackPanel>

                <Button x:Name="TestAudioButton"
                        Classes="secondary"
                        Content="{x:Static res:SettingsStrings.TestAudioButton}"
                        Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,12,0,0">
            <Button x:Name="CancelButton" Classes="ghost" Content="{x:Static gres:GlobalStrings.CancelButton}" />
            <Button x:Name="OkButton" Classes="primary" Content="{x:Static gres:GlobalStrings.OkButton}" />
        </StackPanel>
    </Grid>
</Window>