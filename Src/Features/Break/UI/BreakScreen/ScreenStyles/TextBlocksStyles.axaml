<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBlock.countdown-number">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}" />
        <Setter Property="FontSize" Value="72" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="LineHeight" Value="76" />
    </Style>
    <Style Selector="TextBlock.countdown-caption">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>
    <Style Selector="TextBlock.countdown-finished">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="200" />
    </Style>
    <Style Selector="TextBlock.header">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlBackgroundAccentBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.countdown-value">
        <Setter Property="FontFamily" Value="{StaticResource HeaderFont}" />
        <Setter Property="FontSize" Value="52" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
</Styles>