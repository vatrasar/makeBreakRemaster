<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shellres="using:makeBreak.Src.Features.Shell.Resources"
             x:Class="makeBreak.App">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://makeBreak/Src/Shared/GlobalStyles/Fonts.axaml" />
                <ResourceInclude Source="avares://makeBreak/Src/Shared/GlobalStyles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/ikona.png"
                      ToolTipText="{x:Static shellres:ShellStrings.MainWindowTitle}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{x:Static shellres:ShellStrings.TraySettings}" Click="TraySettings_OnClick" />
                        <NativeMenuItem Header="{x:Static shellres:ShellStrings.TrayShowProgress}" Click="TrayShowProgress_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static shellres:ShellStrings.TrayStop}" IsEnabled="False" Click="TrayStop_OnClick" />
                        <NativeMenuItem Header="{x:Static shellres:ShellStrings.TrayResume}" IsEnabled="False" Click="TrayResume_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{x:Static shellres:ShellStrings.TrayExit}" Click="TrayExit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>